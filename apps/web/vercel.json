{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci -w @isa/web --include-workspace-root",
  "buildCommand": "cd ../.. && npm run build -w @isa/web",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "isaindalimentos.com.br"
        }
      ],
      "destination": "/site/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.isaindalimentos.com.br"
        }
      ],
      "destination": "/site/index.html"
    }
  ]
}
